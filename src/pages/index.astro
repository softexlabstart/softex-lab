---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="SoftexLabs - Soluciones Tecnológicas" description="Proveer soluciones tecnológicas adaptables para todo tipo de negocios">
  <Header slot="header" />

  <!-- Hero Section with enhanced animations -->
  <section class="py-20 relative overflow-hidden" aria-labelledby="hero-heading">
    <!-- Decorative gradient blobs -->
    <div class="absolute top-0 left-0 w-96 h-96 bg-purple-300 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob"></div>
    <div class="absolute top-0 right-0 w-96 h-96 bg-blue-300 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob animation-delay-2000"></div>
    <div class="absolute -bottom-8 left-20 w-96 h-96 bg-pink-300 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob animation-delay-4000"></div>

    <div class="relative grid grid-cols-1 lg:grid-cols-2 items-center gap-12">
      <div class="fade-in-left">
        <div class="inline-block px-4 py-2 bg-gradient-to-r from-purple-100 to-blue-100 rounded-full mb-6 fade-in-up">
          <span class="text-sm font-semibold bg-gradient-to-r from-purple-600 to-blue-600 bg-clip-text text-transparent">
            ✨ Tecnología al alcance de todos
          </span>
        </div>

        <h1 id="hero-heading" class="text-5xl sm:text-6xl lg:text-7xl font-extrabold leading-tight fade-in-up delay-100">
          <span class="text-slate-900">Impulsa tu negocio con</span>
          <span class="gradient-text block mt-2">Soluciones Inteligentes</span>
        </h1>

        <p class="mt-6 text-lg text-slate-600 max-w-xl leading-relaxed fade-in-up delay-200">
          Transformamos procesos, mejoramos la experiencia de tus clientes y ayudamos a escalar operaciones con herramientas intuitivas diseñadas para el éxito de tu negocio.
        </p>

        <div class="mt-10 flex flex-wrap gap-4 fade-in-up delay-300">
          <a class="btn-primary" href="/servicios" role="button">
            Conoce nuestras soluciones
            <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
          <a class="btn-outline" href="/contacto" role="button">
            Solicitar Demo
          </a>
        </div>
      </div>

      <div class="fade-in-right delay-200">
        <div class="relative">
          <!-- Glow effect -->
          <div class="absolute inset-0 bg-gradient-to-r from-purple-400 to-blue-400 rounded-3xl blur-2xl opacity-20"></div>

          <div class="relative glass-card p-8 rounded-3xl shadow-2xl float">
            <div class="bg-gradient-to-br from-slate-50 to-slate-100 rounded-2xl p-6 border border-white/60 shadow-inner">
              <img src="/images/principal.png" alt="Dashboard principal de Ordo" width="800" height="600" loading="lazy" class="rounded-lg">
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-20" aria-label="Características principales">
    <div class="text-center mb-16 fade-in-up">
      <h2 class="text-4xl font-bold text-slate-900">
        ¿Por qué elegir <span class="gradient-text">SoftexLabs</span>?
      </h2>
      <p class="mt-4 text-lg text-slate-600 max-w-2xl mx-auto">
        Soluciones diseñadas para impulsar el crecimiento de tu negocio
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <div class="gradient-card p-8 rounded-2xl fade-in-up delay-100">
        <div class="w-14 h-14 bg-gradient-to-br from-purple-500 to-blue-500 rounded-xl flex items-center justify-center mb-6 shadow-lg">
          <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </div>
        <h3 class="font-bold text-2xl mb-3 text-slate-900">¿Quiénes somos?</h3>
        <p class="text-slate-600 leading-relaxed">
          Somos una compañía a nivel nacional que busca mejorar la experiencia para las empresas aliadas al momento de gestionar sus clientes y agendar citas de manera totalmente digital.
        </p>
      </div>

      <div class="gradient-card p-8 rounded-2xl fade-in-up delay-200">
        <div class="w-14 h-14 bg-gradient-to-br from-pink-500 to-orange-500 rounded-xl flex items-center justify-center mb-6 shadow-lg">
          <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
          </svg>
        </div>
        <h3 class="font-bold text-2xl mb-3 text-slate-900">Nuestros Productos</h3>
        <p class="text-slate-600 leading-relaxed mb-4">
          <strong class="text-slate-900">Ordo</strong> — Sistema de gestión de citas multi-tenant. Multi-sede, calendario intuitivo y reportes en tiempo real.
        </p>
        <a href="/ordo" class="inline-flex items-center font-semibold bg-gradient-to-r from-purple-600 to-blue-600 bg-clip-text text-transparent hover:from-purple-700 hover:to-blue-700 transition-all group">
          Ver Ordo
          <svg class="ml-2 w-5 h-5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
      </div>

      <div class="gradient-card p-8 rounded-2xl fade-in-up delay-300">
        <div class="w-14 h-14 bg-gradient-to-br from-blue-500 to-cyan-500 rounded-xl flex items-center justify-center mb-6 shadow-lg">
          <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
        </div>
        <h3 class="font-bold text-2xl mb-3 text-slate-900">Contacto</h3>
        <div class="space-y-3">
          <a href="mailto:info@softexlab.com" class="flex items-center text-slate-600 hover:text-purple-600 transition-colors group">
            <svg class="w-5 h-5 mr-2 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            info@softexlab.com
          </a>
          <a href="https://wa.me/573193636323" target="_blank" rel="noopener" class="flex items-center text-slate-600 hover:text-green-600 transition-colors group">
            <svg class="w-5 h-5 mr-2 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            +57 319 363 6323
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20">
    <div class="relative overflow-hidden rounded-3xl">
      <div class="absolute inset-0 bg-gradient-to-r from-purple-600 via-blue-600 to-purple-600 opacity-90"></div>
      <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-10"></div>

      <div class="relative px-8 py-16 text-center fade-in-up">
        <h2 class="text-4xl font-bold text-white mb-6">
          ¿Listo para transformar tu negocio?
        </h2>
        <p class="text-xl text-white/90 mb-10 max-w-2xl mx-auto">
          Únete a cientos de empresas que ya confían en nuestras soluciones
        </p>
        <a href="/contacto" class="inline-flex items-center px-10 py-4 bg-white text-purple-600 rounded-full font-bold text-lg shadow-2xl hover:shadow-3xl hover:scale-105 transition-all duration-300">
          Comienza ahora
          <svg class="ml-2 w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  @keyframes blob {
    0%, 100% {
      transform: translate(0px, 0px) scale(1);
    }
    33% {
      transform: translate(30px, -50px) scale(1.1);
    }
    66% {
      transform: translate(-20px, 20px) scale(0.9);
    }
  }

  .animate-blob {
    animation: blob 7s infinite;
  }

  .animation-delay-2000 {
    animation-delay: 2s;
  }

  .animation-delay-4000 {
    animation-delay: 4s;
  }
</style>
