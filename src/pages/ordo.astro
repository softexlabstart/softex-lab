---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Ordo - Gestión de Citas Inteligente" description="Ordo: La forma más simple de administrar tu agenda, clientes y servicios" image="/og/ordo-og.svg" url="https://softexlabs.shop/ordo">
  <Header slot="header" />

  <!-- Hero -->
  <section class="py-14 grid lg:grid-cols-2 gap-10 items-center">
    <div>
      <h1 class="text-5xl sm:text-6xl font-extrabold leading-tight fade-in">Ordo - <span class="gradient-text">Gestión de Citas Inteligente</span></h1>
      <p class="mt-5 text-slate-600 max-w-lg">La forma más simple de administrar tu agenda, clientes y servicios.</p>

      <div class="mt-8 flex gap-4">
  <a href="/contacto" class="btn-primary">Solicitar Demo Gratuita</a>
        <a href="#video" class="btn-outline">Ver Demo</a>
      </div>
    </div>

    <div>
      <div class="glass-card p-8 rounded-3xl shadow-2xl">
        <div class="bg-slate-100 rounded-lg p-6 border border-white/60 flex items-center justify-center">
          <img src="/images/login.png" alt="Ordo - pantalla de login" loading="lazy" class="rounded-lg object-cover w-full max-h-[48vh] sm:max-h-[420px] shadow-lg" />
        </div>
      </div>
    </div>
  </section>

  <!-- ¿Qué es Ordo? -->
  <section class="py-10">
    <h2 class="text-2xl font-semibold">¿Qué es Ordo?</h2>
    <p class="mt-3 text-slate-600 max-w-3xl">Ordo es un sistema de gestión de citas multi-tenant pensado para pequeñas y medianas empresas que requieren un manejo multi-sede, reportes y una experiencia simple para usuarios y administradores. (Texto editable)</p>

    <div class="mt-6 grid sm:grid-cols-3 gap-4">
      <div class="glass-card p-4 rounded-lg">
        <h4 class="font-semibold">Calendario Intuitivo</h4>
        <p class="text-sm text-slate-600 mt-2">Visualiza todas tus citas en un calendario fácil de usar.</p>
      </div>
      <div class="glass-card p-4 rounded-lg">
        <h4 class="font-semibold">Gestión de Clientes</h4>
        <p class="text-sm text-slate-600 mt-2">Historial completo de cada cliente en un solo lugar.</p>
      </div>
      <div class="glass-card p-4 rounded-lg">
        <h4 class="font-semibold">Multi-sede</h4>
        <p class="text-sm text-slate-600 mt-2">Administra múltiples sucursales desde una sola cuenta.</p>
      </div>
    </div>
  </section>

  <!-- Características Principales (Grid 2x2) -->
  <section class="py-10">
    <h3 class="text-xl font-semibold">Características Principales</h3>
    <div class="mt-6 grid md:grid-cols-2 gap-6">
      <div class="glass-card p-4 rounded-lg flex gap-4 items-start">
        <div class="text-2xl">📅</div>
        <div>
          <h4 class="font-semibold">Calendario Intuitivo</h4>
          <p class="text-sm text-slate-600">Visualiza todas tus citas en un calendario fácil de usar.</p>
          <img src="/images/calendario.png" alt="Captura Calendario - Ordo" class="mt-3 rounded w-full h-40 sm:h-52 object-cover shadow" loading="lazy">
        </div>
      </div>

      <div class="glass-card p-4 rounded-lg flex gap-4 items-start">
        <div class="text-2xl">👥</div>
        <div>
          <h4 class="font-semibold">Gestión de Clientes</h4>
          <p class="text-sm text-slate-600">Historial completo de cada cliente en un solo lugar.</p>
          <img src="/images/Clientes.png" alt="Captura Gestión de Clientes - Ordo" class="mt-3 rounded w-full h-40 sm:h-52 object-cover shadow" loading="lazy">
        </div>
      </div>

      <div class="glass-card p-4 rounded-lg flex gap-4 items-start">
        <div class="text-2xl">🏢</div>
        <div>
          <h4 class="font-semibold">Multi-sede</h4>
          <p class="text-sm text-slate-600">Administra múltiples sucursales desde una sola cuenta.</p>
          <img src="/images/multisede.png" alt="Captura Multi-sede - Ordo" class="mt-3 rounded w-full h-40 sm:h-52 object-cover shadow" loading="lazy">
        </div>
      </div>

      <div class="glass-card p-4 rounded-lg flex gap-4 items-start">
        <div class="text-2xl">📊</div>
        <div>
          <h4 class="font-semibold">Reportes en Tiempo Real</h4>
          <p class="text-sm text-slate-600">Toma decisiones basadas en datos actualizados.</p>
          <img src="/images/Reportes.png" alt="Captura Reportes - Ordo" class="mt-3 rounded w-full h-40 sm:h-52 object-cover shadow" loading="lazy">
        </div>
      </div>
    </div>
  </section>

  <!-- ¿Para quién es Ordo? -->
  <section class="py-10">
    <h3 class="text-xl font-semibold">¿Para quién es Ordo?</h3>
    <div class="mt-4 grid sm:grid-cols-2 md:grid-cols-3 gap-4">
      <div class="glass-card p-4 rounded-lg">💇 Peluquerías y Barberías</div>
      <div class="glass-card p-4 rounded-lg">💆 SPAs y Centros de Bienestar</div>
      <div class="glass-card p-4 rounded-lg">🏥 Clínicas y Consultorios</div>
      <div class="glass-card p-4 rounded-lg">🏦 Instituciones con Agendamiento</div>
      <div class="glass-card p-4 rounded-lg">🏢 Cualquier negocio con citas</div>
    </div>
  </section>

  <!-- Cómo funciona (3 pasos) -->
  <section class="py-10">
    <h3 class="text-xl font-semibold">Cómo funciona</h3>
    <div class="mt-4 grid md:grid-cols-3 gap-4">
      <div class="glass-card p-6 rounded-lg">
        <h4 class="font-semibold">Paso 1</h4>
        <p class="text-slate-600">Contáctanos y configuramos tu cuenta.</p>
      </div>
      <div class="glass-card p-6 rounded-lg">
        <h4 class="font-semibold">Paso 2</h4>
        <p class="text-slate-600">Personaliza servicios, horarios y usuarios.</p>
      </div>
      <div class="glass-card p-6 rounded-lg">
        <h4 class="font-semibold">Paso 3</h4>
        <p class="text-slate-600">Comienza a recibir y gestionar citas.</p>
      </div>
    </div>
  </section>

  <!-- Video explicativo -->
  <section id="video" class="py-10">
    <h3 class="text-xl font-semibold">Ve Ordo en acción</h3>
    <div class="mt-4 aspect-w-16 aspect-h-9 bg-black/5 rounded overflow-hidden">
      <iframe width="100%" height="480" src="https://www.youtube.com/embed/" title="Ordo video placeholder" frameborder="0" allowfullscreen></iframe>
    </div>
  </section>

  <!-- CTA final -->
  <section class="py-12 text-center">
    <h2 class="text-2xl font-bold">¿Listo para transformar la gestión de tu negocio?</h2>
    <p class="mt-3 text-slate-600">Empieza con una demo personalizada.</p>
    <div class="mt-6 flex justify-center gap-4">
  <a href="/contacto" class="px-6 py-3 rounded-lg bg-blue-600 text-white">Solicitar Demo Personalizada</a>
      <a href="https://wa.me/573193636323" class="px-6 py-3 rounded-lg border">Contáctanos por WhatsApp</a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
