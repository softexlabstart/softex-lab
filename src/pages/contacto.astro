---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Contacto - SoftexLabs" description="Contáctanos para solicitar una demo o más información"> 
  <Header slot="header" />

  <section class="py-12 max-w-3xl mx-auto">
    <h1 class="text-2xl font-bold">Contacto</h1>
    <p class="mt-2 text-slate-600">Rellena el formulario y te contactaremos para coordinar una demo.</p>

    <form id="contact-form" class="mt-6 grid grid-cols-1 gap-4" on:submit preventdefault>
      <label class="flex flex-col">
        <span class="text-sm">Nombre *</span>
        <input id="name" required class="mt-1 p-3 rounded border" />
      </label>

      <label class="flex flex-col">
        <span class="text-sm">Email *</span>
        <input id="email" type="email" required class="mt-1 p-3 rounded border" />
      </label>

      <label class="flex flex-col">
        <span class="text-sm">Teléfono / WhatsApp *</span>
        <input id="phone" required class="mt-1 p-3 rounded border" />
      </label>

      <label class="flex flex-col">
        <span class="text-sm">Tipo de negocio *</span>
        <select id="businessType" class="mt-1 p-3 rounded border" required>
          <option>Selecciona...</option>
          <option>Peluquería</option>
          <option>SPA</option>
          <option>Clínica</option>
          <option>Banco</option>
          <option>Otro</option>
        </select>
      </label>

      <label class="flex flex-col">
        <span class="text-sm">Número de sedes *</span>
        <select id="locations" class="mt-1 p-3 rounded border" required>
          <option>Selecciona...</option>
          <option>1</option>
          <option>2-5</option>
          <option>6-10</option>
          <option>10+</option>
        </select>
      </label>

      <label class="flex flex-col">
        <span class="text-sm">Mensaje (opcional)</span>
        <textarea id="message" rows="4" class="mt-1 p-3 rounded border"></textarea>
      </label>

      <div class="flex gap-3">
        <button id="sendBtn" type="submit" class="px-5 py-3 rounded bg-blue-600 text-white hover:bg-blue-700 transition-colors">
          <span id="sendBtnText">Enviar Solicitud</span>
          <span id="sendBtnLoading" class="hidden">Enviando...</span>
        </button>
        <a id="whatsBtn" href="#" class="px-5 py-3 rounded border hover:bg-slate-50 transition-colors">Escribir por WhatsApp</a>
      </div>
      <div id="formSuccess" class="hidden mt-4 p-4 rounded bg-green-50 text-green-700 border border-green-200">
        Solicitud enviada correctamente. Te contactaremos pronto.
      </div>
      <div id="formError" class="hidden mt-4 p-4 rounded bg-red-50 text-red-700 border border-red-200">
        Hubo un error al enviar la solicitud. Por favor intenta nuevamente o usa WhatsApp.
      </div>
    </form>

    <script>
      const form = document.getElementById('contact-form');
      const whatsBtn = document.getElementById('whatsBtn');
      const sendBtn = document.getElementById('sendBtn');
      const sendBtnText = document.getElementById('sendBtnText');
      const sendBtnLoading = document.getElementById('sendBtnLoading');
      const formSuccess = document.getElementById('formSuccess');
      const formError = document.getElementById('formError');

      function buildMessage(){
        const name = document.getElementById('name').value || '';
        const email = document.getElementById('email').value || '';
        const phone = document.getElementById('phone').value || '';
        const business = document.getElementById('businessType').value || '';
        const locations = document.getElementById('locations').value || '';
        const message = document.getElementById('message').value || '';
        return {
          name,
          email,
          phone,
          businessType: business,
          locations,
          message
        };
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        // Reset states
        formSuccess.classList.add('hidden');
        formError.classList.add('hidden');
        sendBtn.disabled = true;
        sendBtnText.classList.add('hidden');
        sendBtnLoading.classList.remove('hidden');
        
        try {
          const formData = buildMessage();
          const response = await fetch('/api/send-email', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify(formData),
          });

          if (response.ok) {
            formSuccess.classList.remove('hidden');
            form.reset();
          } else {
            formError.classList.remove('hidden');
          }
        } catch (error) {
          console.error('Error:', error);
          formError.classList.remove('hidden');
        } finally {
          sendBtn.disabled = false;
          sendBtnText.classList.remove('hidden');
          sendBtnLoading.classList.add('hidden');
        }
      });

      whatsBtn.addEventListener('click', (e)=>{
        e.preventDefault();
        const data = buildMessage();
        const text = `Hola, me gustaría solicitar una demo de Ordo. Nombre: ${data.name} Email: ${data.email} Teléfono: ${data.phone} Tipo de negocio: ${data.businessType} Número de sedes: ${data.locations} Mensaje: ${data.message}`;
        const url = `https://wa.me/573193636323?text=${encodeURIComponent(text)}`;
        window.open(url, '_blank');
      });
    </script>
  </section>

  <Footer slot="footer" />
</BaseLayout>
