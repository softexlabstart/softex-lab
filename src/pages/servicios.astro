---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Servicios - SoftexLabs" description="Conoce nuestras soluciones: Ordo, y más">
  <Header slot="header" />

  <!-- Hero Section -->
  <section class="py-20 relative overflow-hidden">
    <div class="absolute top-0 left-0 w-96 h-96 bg-purple-300 rounded-full mix-blend-multiply filter blur-3xl opacity-20"></div>
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-blue-300 rounded-full mix-blend-multiply filter blur-3xl opacity-20"></div>

    <div class="relative text-center fade-in-up">
      <div class="inline-block px-4 py-2 bg-gradient-to-r from-purple-100 to-blue-100 rounded-full mb-6">
        <span class="text-sm font-semibold bg-gradient-to-r from-purple-600 to-blue-600 bg-clip-text text-transparent">
          Nuestras Soluciones
        </span>
      </div>

      <h1 class="text-5xl sm:text-6xl font-extrabold leading-tight mb-6">
        Soluciones que <br/>
        <span class="gradient-text">transforman negocios</span>
      </h1>

      <p class="text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
        Productos pensados para facilitar la operación de negocios con citas y agendas. Tecnología potente, diseño intuitivo.
      </p>
    </div>
  </section>

  <!-- Main Product: Ordo -->
  <section class="py-20">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div class="fade-in-left">
        <div class="inline-block px-4 py-2 bg-gradient-to-r from-pink-100 to-orange-100 rounded-full mb-6">
          <span class="text-sm font-semibold bg-gradient-to-r from-pink-600 to-orange-600 bg-clip-text text-transparent">
            ⭐ Producto destacado
          </span>
        </div>

        <h2 class="text-4xl font-bold text-slate-900 mb-4">
          <span class="gradient-text">Ordo</span> - Sistema de Gestión de Citas
        </h2>

        <p class="text-lg text-slate-600 mb-8 leading-relaxed">
          Administra citas, clientes y servicios desde una plataforma adaptable a cualquier negocio. Multi-sede, calendario intuitivo y reportes en tiempo real.
        </p>

        <div class="space-y-4 mb-8">
          <div class="flex items-start">
            <div class="w-6 h-6 bg-gradient-to-br from-green-500 to-emerald-500 rounded-lg flex items-center justify-center mr-3 mt-1">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-slate-900">Gestión Multi-sede</h3>
              <p class="text-slate-600">Administra múltiples ubicaciones desde un solo panel</p>
            </div>
          </div>

          <div class="flex items-start">
            <div class="w-6 h-6 bg-gradient-to-br from-blue-500 to-cyan-500 rounded-lg flex items-center justify-center mr-3 mt-1">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-slate-900">Calendario Inteligente</h3>
              <p class="text-slate-600">Visualización clara y gestión eficiente de horarios</p>
            </div>
          </div>

          <div class="flex items-start">
            <div class="w-6 h-6 bg-gradient-to-br from-purple-500 to-pink-500 rounded-lg flex items-center justify-center mr-3 mt-1">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-slate-900">Reportes en Tiempo Real</h3>
              <p class="text-slate-600">Toma decisiones informadas con datos actualizados</p>
            </div>
          </div>

          <div class="flex items-start">
            <div class="w-6 h-6 bg-gradient-to-br from-orange-500 to-red-500 rounded-lg flex items-center justify-center mr-3 mt-1">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-slate-900">Multi-tenant</h3>
              <p class="text-slate-600">Arquitectura escalable para múltiples clientes</p>
            </div>
          </div>
        </div>

        <a href="/ordo" class="btn-primary">
          Conocer más sobre Ordo
          <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
      </div>

      <div class="fade-in-right delay-200">
        <div class="relative">
          <div class="absolute inset-0 bg-gradient-to-r from-purple-400 to-pink-400 rounded-3xl blur-2xl opacity-20"></div>
          <div class="relative glass-card p-8 rounded-3xl shadow-2xl">
            <img src="/images/principal.png" alt="Dashboard principal de Ordo" class="rounded-2xl shadow-lg" loading="lazy">
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Grid -->
  <section class="py-20 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-purple-50 via-blue-50 to-pink-50 opacity-50 rounded-3xl"></div>

    <div class="relative">
      <div class="text-center mb-16 fade-in-up">
        <h2 class="text-4xl font-bold text-slate-900 mb-4">
          Características <span class="gradient-text">principales</span>
        </h2>
        <p class="text-lg text-slate-600 max-w-2xl mx-auto">
          Todo lo que necesitas para gestionar tu negocio de manera eficiente
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="gradient-card p-6 rounded-2xl fade-in-up delay-100">
          <div class="w-12 h-12 bg-gradient-to-br from-purple-500 to-blue-500 rounded-xl flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h3 class="font-bold text-lg text-slate-900 mb-2">Gestión de Citas</h3>
          <p class="text-slate-600">Agenda, reagenda y cancela citas con facilidad</p>
        </div>

        <div class="gradient-card p-6 rounded-2xl fade-in-up delay-200">
          <div class="w-12 h-12 bg-gradient-to-br from-pink-500 to-orange-500 rounded-xl flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
            </svg>
          </div>
          <h3 class="font-bold text-lg text-slate-900 mb-2">Base de Clientes</h3>
          <p class="text-slate-600">Registra y gestiona información de tus clientes</p>
        </div>

        <div class="gradient-card p-6 rounded-2xl fade-in-up delay-300">
          <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-cyan-500 rounded-xl flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
            </svg>
          </div>
          <h3 class="font-bold text-lg text-slate-900 mb-2">Reportes Avanzados</h3>
          <p class="text-slate-600">Analítica completa del rendimiento de tu negocio</p>
        </div>

        <div class="gradient-card p-6 rounded-2xl fade-in-up delay-100">
          <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-emerald-500 rounded-xl flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h3 class="font-bold text-lg text-slate-900 mb-2">Responsive Design</h3>
          <p class="text-slate-600">Accede desde cualquier dispositivo</p>
        </div>

        <div class="gradient-card p-6 rounded-2xl fade-in-up delay-200">
          <div class="w-12 h-12 bg-gradient-to-br from-yellow-500 to-orange-500 rounded-xl flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
            </svg>
          </div>
          <h3 class="font-bold text-lg text-slate-900 mb-2">Notificaciones</h3>
          <p class="text-slate-600">Recordatorios automáticos para tus clientes</p>
        </div>

        <div class="gradient-card p-6 rounded-2xl fade-in-up delay-300">
          <div class="w-12 h-12 bg-gradient-to-br from-indigo-500 to-purple-500 rounded-xl flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path>
            </svg>
          </div>
          <h3 class="font-bold text-lg text-slate-900 mb-2">Personalizable</h3>
          <p class="text-slate-600">Adapta el sistema a tus necesidades</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Coming Soon Section -->
  <section class="py-20">
    <div class="text-center mb-12 fade-in-up">
      <h2 class="text-4xl font-bold text-slate-900 mb-4">
        Próximamente
      </h2>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto">
        Estamos trabajando en más soluciones para impulsar tu negocio
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      <div class="glass-card p-8 rounded-2xl text-center fade-in-up delay-100">
        <div class="w-16 h-16 bg-gradient-to-br from-slate-300 to-slate-400 rounded-2xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
          </svg>
        </div>
        <h3 class="font-bold text-xl text-slate-900 mb-2">Sistema de Pagos</h3>
        <p class="text-slate-600">Integración con pasarelas de pago</p>
        <div class="mt-4 inline-block px-3 py-1 bg-slate-100 rounded-full text-sm text-slate-600">
          En desarrollo
        </div>
      </div>

      <div class="glass-card p-8 rounded-2xl text-center fade-in-up delay-200">
        <div class="w-16 h-16 bg-gradient-to-br from-slate-300 to-slate-400 rounded-2xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
          </svg>
        </div>
        <h3 class="font-bold text-xl text-slate-900 mb-2">E-commerce</h3>
        <p class="text-slate-600">Vende productos online</p>
        <div class="mt-4 inline-block px-3 py-1 bg-slate-100 rounded-full text-sm text-slate-600">
          Planificado
        </div>
      </div>

      <div class="glass-card p-8 rounded-2xl text-center fade-in-up delay-300">
        <div class="w-16 h-16 bg-gradient-to-br from-slate-300 to-slate-400 rounded-2xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"></path>
          </svg>
        </div>
        <h3 class="font-bold text-xl text-slate-900 mb-2">CRM Avanzado</h3>
        <p class="text-slate-600">Gestión completa de relaciones</p>
        <div class="mt-4 inline-block px-3 py-1 bg-slate-100 rounded-full text-sm text-slate-600">
          En investigación
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20">
    <div class="relative overflow-hidden rounded-3xl">
      <div class="absolute inset-0 bg-gradient-to-r from-purple-600 via-blue-600 to-purple-600 opacity-90"></div>

      <div class="relative px-8 py-16 text-center fade-in-up">
        <h2 class="text-4xl font-bold text-white mb-6">
          ¿Listo para empezar?
        </h2>
        <p class="text-xl text-white/90 mb-10 max-w-2xl mx-auto">
          Solicita una demo personalizada y descubre cómo nuestras soluciones pueden transformar tu negocio
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
          <a href="/contacto" class="inline-flex items-center px-10 py-4 bg-white text-purple-600 rounded-full font-bold text-lg shadow-2xl hover:shadow-3xl hover:scale-105 transition-all duration-300">
            Solicitar Demo
            <svg class="ml-2 w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
          <a href="/ordo" class="inline-flex items-center px-10 py-4 bg-white/10 backdrop-blur-sm text-white border-2 border-white/30 rounded-full font-bold text-lg hover:bg-white/20 transition-all duration-300">
            Ver Ordo
          </a>
        </div>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
