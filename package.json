{
  "name": "softex-labs-landing",
  "version": "2.0.0",
  "description": "Landing page mejorada para Softex Labs con funcionalidades avanzadas",
  "main": "app.js",
  "scripts": {
    "dev": "astro dev",
    "build:css": "npx tailwindcss -i src/styles/global.css -o public/build/tailwind.css --minify",
    "build": "npm run build:css && astro build",
    "generate:og": "node scripts/generate-og.js",
    "preview": "astro preview",
    "test": "echo 'No tests specified'",
    "lint": "echo 'No linting configured'",
    "deploy": "vercel --prod",
    "clean": "rm -rf dist public/build"
  },
  "keywords": [
    "landing-page",
    "softex-labs",
    "pymes",
    "tecnologia",
    "desarrollo-software"
  ],
  "author": "Softex Labs",
  "license": "MIT",
  "dependencies": {
    "@vercel/analytics": "^1.0.0",
    "dotenv": "^17.2.3",
    "nodemailer": "^7.0.10"
  },
  "devDependencies": {
    "@astrojs/node": "^9.5.0",
    "@astrojs/vercel": "^9.0.0",
    "@types/node": "^20.19.24",
    "@types/nodemailer": "^7.0.3",
    "astro": "^5.15.3",
    "autoprefixer": "^10.4.21",
    "http-server": "^14.1.1",
    "postcss": "^8.5.6",
    "sharp": "^0.32.0",
    "tailwindcss": "^3.4.18"
  },
  "engines": {
    "node": "22.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/softex-labs/landing.git"
  },
  "homepage": "https://softex-labs.xyz"
}
